NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Amazon Cognito (public client — no secret)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_xxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=ap-south-1

# Required for Google sign-in (Cognito Hosted UI domain prefix only, no https://)
# Example: adda-ai-auth.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Optional override lists (comma-separated). Defaults cover local + Amplify.
# NEXT_PUBLIC_OAUTH_REDIRECT_SIGN_IN=http://127.0.0.1:3000/,https://main.dvhyzvzxczywv.amplifyapp.com/
# NEXT_PUBLIC_OAUTH_REDIRECT_SIGN_OUT=http://127.0.0.1:3000/login/,https://main.dvhyzvzxczywv.amplifyapp.com/login/
