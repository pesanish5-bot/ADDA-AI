# Copy to services/api/.env for local work. Never commit the real file.

# development | staging | production. Non-development enforces https origins and
# refuses the demo fixture unless ALLOW_DEMO_FIXTURE=true.
APP_ENV=development
LOG_LEVEL=INFO

# demo returns a labelled fixed fixture for the Coding route (a connection test, not AI).
# bedrock calls Amazon Bedrock Converse with the AWS credential chain configured outside this repo.
NEXUS_PROVIDER=demo
ALLOW_DEMO_FIXTURE=false
AWS_REGION=ap-south-1
# Converse-compatible model ID or inference profile available to your account. Required for bedrock.
# Recommended: global.anthropic.claude-haiku-4-5-20251001-v1:0 (cost-effective coding model, ap-south-1 via global profile).
BEDROCK_MODEL_ID=
# Hard cap on generated tokens per Coding request (1-8000); per-attempt read timeout (1-25 s);
# attempts including the first (1-3), retried only on throttling / transient service errors.
BEDROCK_MAX_TOKENS=1500
BEDROCK_TIMEOUT_SECONDS=20
BEDROCK_MAX_ATTEMPTS=2

# Exact origins, comma separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared gate until real authentication (see docs/adr/0003-authentication.md).
DEMO_ACCESS_TOKEN=
# Backend-only Tavily key. Enables the Search agent when set.
TAVILY_API_KEY=

# Documents: process memory locally; set a private bucket for any multi-instance deployment.
DOCUMENT_ENABLED=true
DOCUMENT_BUCKET=

# Per-client, per-process abuse brakes (requests per minute). Edge throttling still applies.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60
# Only true behind a proxy you control that sets X-Forwarded-For (ALB, nginx).
TRUST_PROXY_HEADERS=false
